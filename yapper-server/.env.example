# Environment variables the Yapper server reads at startup.
# This file only documents them; set them in your run configuration,
# your shell, or your deployment (e.g. systemd or Docker).

# Port the server listens on (optional, default: 9099)
YAPPER_SERVER_PORT=9099

# MySQL connection (required)
YAPPER_DB_URL=jdbc:mysql://your-db-host:3306/your-db-name
YAPPER_DB_USER=your-db-user
YAPPER_DB_PASSWORD=your-db-password

# TLS keystore with the server's private key and certificate
# Path is optional (default: server.p12), the password is required
YAPPER_KEYSTORE=path/to/your-keystore.p12
YAPPER_KEYSTORE_PASSWORD=your-keystore-password