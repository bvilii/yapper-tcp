# Example configuration. Copy this file to .env and fill in real values.
#
# docker compose reads .env automatically from this folder.
# When you run the server without Docker (IntelliJ, java -jar),
# set the YAPPER_* variables in your run configuration instead.

# ---------- MySQL (used by the mysql container) ----------

# Password of MySQL's root user, only MySQL itself uses it
MYSQL_ROOT_PASSWORD=your-root-password

# Name of the database MySQL creates on its first start
MYSQL_DATABASE=yapper

# ---------- Shared by MySQL and the server ----------

# The database user: MySQL creates it, the server logs in with it
YAPPER_DB_USER=your-db-user
YAPPER_DB_PASSWORD=your-db-password

# ---------- Yapper server ----------

# Port the server listens on (optional, default: 9099)
YAPPER_SERVER_PORT=9099

# JDBC URL of the database (required)
# With docker compose the host is the service name: jdbc:mysql://mysql:3306/yapper
YAPPER_DB_URL=jdbc:mysql://mysql:3306/yapper

# TLS keystore with the server's private key and certificate (the password is required)
# Path of the keystore file on this machine; compose mounts it into the container
YAPPER_KEYSTORE_FILE=path/to/server.p12
YAPPER_KEYSTORE_PASSWORD=your-keystore-password